# AI: local models with Ollama, Claude desktop and Claude Code.
#
# Applied by install.sh with `brew bundle --file=<this> --no-upgrade`. The
# cross-platform half of this profile is common/profiles/ai.txt.

cask "ollama-app"
cask "claude"                   # desktop app; the Claude Code CLI is an npm global in common/profiles/ai.txt
brew "node"                     # npm, for the Claude Code CLI
