# Containers and Kubernetes.
#
# Applied by install.sh with `brew bundle --file=<this> --no-upgrade`. The
# cross-platform half of this profile is common/profiles/containers.txt.

cask "docker-desktop"
brew "kubernetes-cli"
brew "helm"
brew "k9s"
brew "kind"
brew "lazydocker"
brew "dive"                     # image layer inspector
brew "kubectx"                  # kubectx and kubens
brew "stern"                    # multi-pod log tailing
