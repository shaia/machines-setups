# C and C++. Apple clang comes with the Command Line Tools; this adds the rest.
#
# Applied by install.sh with `brew bundle --file=<this> --no-upgrade`. The
# cross-platform half of this profile is common/profiles/cpp.txt.

brew "cmake"
brew "ninja"
brew "llvm"                     # keg-only: clangd and clang-format; Apple clang stays the default compiler
