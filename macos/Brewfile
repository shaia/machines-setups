# Brewfile — snapshot of this Mac's Homebrew state.
#
# Apply with:  brew bundle --file=Brewfile --no-upgrade
# Check with:  brew bundle check --file=Brewfile --verbose
# Refresh with: ./snapshot.sh   (then re-apply the comment blocks at the bottom)
#
# No `tap` lines: this machine uses only homebrew-core and homebrew-cask.

