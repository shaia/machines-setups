# ~/.zshrc - linked from machines-setups/macos/dotfiles/zshrc by install.sh.
#
# oh-my-zsh for its plugins and completion setup, starship for the prompt.
# Homebrew's environment comes from ~/.zprofile, so $HOMEBREW_PREFIX is set.

# --- Warp -------------------------------------------------------------------------
# Warp brings its own input editor, completions, Ctrl+R history search,
# autosuggestions and syntax highlighting, so the fzf key bindings and the two zsh
# plugins at the bottom are skipped inside it. They still load in iTerm2 and VS Code.
[[ $TERM_PROGRAM == WarpTerminal ]] && __warp=1 || __warp=0

# --- oh-my-zsh ------------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""                       # the prompt is starship, initialised below
plugins=(git)

# Docker CLI completions: on fpath BEFORE oh-my-zsh runs compinit, so its single
# compinit picks them up. Docker Desktop creates the directory on first launch.
[[ -d $HOME/.docker/completions ]] && fpath=($HOME/.docker/completions $fpath)

[[ -r $ZSH/oh-my-zsh.sh ]] && source $ZSH/oh-my-zsh.sh

# --- Environment ----------------------------------------------------------------
export PATH="$HOME/.local/bin:$HOME/go/bin:$PATH"

# --- Machine-local overrides ------------------------------------------------------
# Anything specific to one machine or one employer - API keys, GOPRIVATE for a
# private org, an internal registry, work-only PATH entries - belongs in
# ~/.zshrc.local, which no repo tracks. Absent on a fresh machine.
[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local

# --- Aliases --------------------------------------------------------------------
command -v eza >/dev/null 2>&1 && alias ls='eza -al --color=always --group-directories-first'
command -v kubectl >/dev/null 2>&1 && alias k=kubectl

# --- Tools ----------------------------------------------------------------------
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"     # z <dir>, zi
(( ! __warp )) && command -v fzf >/dev/null 2>&1 && source <(fzf --zsh)   # Ctrl+R, Ctrl+T, Alt+C

# --- Prompt -----------------------------------------------------------------------
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

# --- zsh-autosuggestions (must come before syntax-highlighting) ------------------
(( ! __warp )) && [[ -r $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && \
  source $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# --- zsh-syntax-highlighting: MUST be sourced LAST ------------------------------
(( ! __warp )) && [[ -r $HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && \
  source $HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
unset __warp
