# Homebrew environment - the single place brew shellenv runs. Login shells read
# this after macOS's /etc/zprofile path_helper, so brew paths take precedence.
# Apple Silicon installs to /opt/homebrew, Intel to /usr/local.
for __brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
  if [[ -x $__brew ]]; then
    eval "$($__brew shellenv)"
    break
  fi
done
unset __brew
