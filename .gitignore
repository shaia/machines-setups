# Secrets - never commit. Every tracked dotfile is deliberately limited to
# config that contains no credentials.
.ssh/
**/gh/hosts.yml
*.pem
*.key
*_rsa
*_rsa.pub
*_ed25519
*_ed25519.pub
.netrc
**/.aws/credentials

# Machine-local overrides. These live in $HOME and are deliberately outside the
# repo: identity, a work identity and per-machine env (GOPRIVATE, internal
# registries, API keys) do not belong in a shared baseline. Guarded here so a
# stray copy cannot drag them back in.
**/dotfiles/gitconfig-local
**/dotfiles/gitconfig-work
**/dotfiles/*.local
**/dotfiles/*.local.ps1

# macOS
.DS_Store
