export PATH="/c/Program Files/LLVM/bin:$PATH"
# 7-Zip's installer does not add itself to PATH; the scoop shim it replaced did.
[ -d '/c/Program Files/7-Zip' ] && export PATH="$PATH:/c/Program Files/7-Zip"

# --- Machine-local overrides -------------------------------------------------
# Per-machine env - API keys, employer-only PATH entries - belongs in
# ~/.bashrc.local, not in this repo. GEMINI_API_KEY for ~/.claude/scripts
# arrives from the Windows User environment; this is the fallback for a shell
# that does not inherit it. Absent on a fresh machine, which is fine.
[ -r ~/.bashrc.local ] && . ~/.bashrc.local