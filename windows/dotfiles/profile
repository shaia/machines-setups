# Login shells read this file, not ~/.bashrc. Git for Windows only generates a
# ~/.bash_profile that chains the two when ~/.profile does not exist, and it does.
test -f ~/.bashrc && . ~/.bashrc

# uv 0.12.5 (winget). Claude Code tool shells can inherit a PATH with the whole
# HKCU user PATH missing, and then uv and make check fail with "command not found".
# Absolute path, and idempotent so it never doubles up.
uv_dir="$HOME/AppData/Local/Microsoft/WinGet/Packages/astral-sh.uv_Microsoft.Winget.Source_8wekyb3d8bbwe"
case ":$PATH:" in
  *":$uv_dir:"*) ;;
  *) PATH="$uv_dir:$PATH" ;;
esac
unset uv_dir
export PATH
